# Recruiter Copilot Local – backend configuration (copy to .env)
# All values are optional; defaults are shown.

# Where all candidate data is stored (documents, database, logs, benchmarks)
RCL_DATA_DIR=./data

# Local Ollama endpoint. Only hosts in RCL_ALLOWED_OLLAMA_HOSTS are accepted.
RCL_OLLAMA_URL=http://localhost:11434
RCL_ALLOWED_OLLAMA_HOSTS=["localhost","127.0.0.1","::1","host.docker.internal","ollama"]

# Models (must already be installed: models are never pulled automatically)
RCL_PRIMARY_MODEL=qwen3:8b
RCL_SECONDARY_MODEL=qwen2.5:7b
RCL_ALTERNATIVE_MODEL=mistral-nemo:latest
RCL_EMBEDDING_MODEL=nomic-embed-text:latest
RCL_VISION_MODEL=moondream:latest

# Generation defaults (can be changed in the UI: AI settings)
RCL_NUM_CTX=8192
RCL_TEMPERATURE=0.1
RCL_KEEP_ALIVE=10m
RCL_REQUEST_TIMEOUT_S=300
RCL_MAX_REPAIR_ATTEMPTS=2
# Refuse to LOAD a model when less RAM than this is available (MB)
RCL_MIN_FREE_RAM_MB=600

# Limits
RCL_MAX_UPLOAD_MB=10
RCL_MAX_FILES_PER_BATCH=50
RCL_MAX_PDF_PAGES=30

RCL_AUTO_PROCESS_ON_IMPORT=true
RCL_OCR_ENABLED=true
RCL_LOG_LEVEL=INFO

# Frontend (Next.js) – keep telemetry disabled
NEXT_TELEMETRY_DISABLED=1
